+float C_NeoVolSmoke::SampleDensity( const Vector &pos ) const
+{
+	// Cell-centre aligned trilinear lookup, matching the shader's filtering.
+	float f[3]; int i0[3]; float t[3];
+	for ( int a = 0; a < 3; ++a )
+	{
+		f[a]  = ( pos[a] - m_vecGridMin[a] ) / m_flCellSize - 0.5f;
+		if ( f[a] < -1.0f || f[a] > (float)m_nN )
+			return 0.0f;
+		i0[a] = (int)floorf( f[a] );
+		t[a]  = f[a] - (float)i0[a];
+	}
+	float result = 0.0f;
+	for ( int dz = 0; dz < 2; ++dz ) for ( int dy = 0; dy < 2; ++dy ) for ( int dx = 0; dx < 2; ++dx )
+	{
+		const int x = i0[0] + dx, y = i0[1] + dy, z = i0[2] + dz;
+		if ( !InGrid( x, y, z ) ) continue;
+		const float w = ( dx ? t[0] : 1.0f - t[0] ) * ( dy ? t[1] : 1.0f - t[1] ) * ( dz ? t[2] : 1.0f - t[2] );
+		result += w * m_Density[Idx( x, y, z )];
+	}
+	return result;
+}
